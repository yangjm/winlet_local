{
  "name": "winlet-local",
  "version": "2.0.0",
  "description": "Client-side JS engine for Winlet applications",
  "main": "dist/winlet-local.umd.js",
  "module": "dist/winlet-local.esm.js",
  "exports": {
    ".": {
      "import": "./dist/winlet-local.esm.js",
      "require": "./dist/winlet-local.umd.js"
    },
    "./css": "./dist/winlet-local.min.css"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run"
  },
  "keywords": [
    "winlet",
    "js",
    "web"
  ],
  "author": "Jiangming Yang",
  "license": "MIT",
  "homepage": "https://github.com/yangjm/winlet_local",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangjm/winlet_local.git"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.0.0",
    "jsdom": "^29.0.1",
    "rollup": "^4.9.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "vitest": "^4.1.2"
  }
}
